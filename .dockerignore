# Исключаем локальные папки зависимостей и сборки
node_modules
.next
out
build

# Исключаем логи ошибок npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Исключаем скрытую историю Git
.git
.gitignore

# Исключаем файлы локальных настроек редактора
.vscode
.idea

# Исключаем локальные переменные окружения. Именно все, а не только *.local:
# NEXT_PUBLIC_* вшиваются в бандл на сборке, и локальный .env с http://localhost/api
# запёкся бы в продовый образ. Без .env браузер берёт относительный /api — верно для прода.
.env*